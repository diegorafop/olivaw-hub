{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "PostgreSql",
  "authentication": {
    "timeout": 1440,
    "oidc": {
      "issuer": "iss",
      "standard-claims": {
        "sub": "sub",
        "username": "preferred_username",
        "name": "name",
        "email": "email"
      },
      "custom-claims": {
        "matricula": "matricula",
        "emissor": "emissor",
        "ativo": "ativo"
      }
    }
  },
  "swagger": {
    "version": "Version v01.01.02",
    "enabled": true
  },
  "masstransit": {
    "configured": true,
    "brokerTypeEnum": "RabbitMq",
    "server": "rabbit-desenvolvimento.holos.mps.com.br",
    "port": 5672,
    "user": "rabbit",
    "password": "mps2022*",
    "environment": "",
    "virtualhost": ""
  },
  "services": {
    "provider-authentication": {
      "serviceName": "provider-authentication",
      "authenticationType": "Bearer",
      "httpClientTimeout": 300,
      "defaultHeaders": "application/json",
      "cacheKey": "credential",
      "cacheSlidingExpiration": 1420,
      "routes": {
        "autenticar-usuario": "/autenticacao/autenticar"
      },
      "claims": {}
    },
    "auth": {
      "serviceName": "provider-authentication",
      "authenticationType": "Bearer",
      "httpClientTimeout": 300,
      "defaultHeaders": "application/json",
      "routes": {},
      "claims": {}
    }
  },
  "constants": {}
}