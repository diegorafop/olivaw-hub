{
  "ConnectionStrings": {
    "DbContext": "Host=${{DATABASE_ADDRESS}};Port=5432;Pooling=true;Database=${{DATABASE_NAME}};SearchPath=${{DATABASE_SCHEMA}};User Id=${{DATABASE_USER}};Password=${{DATABASE_PASSWORD}}"
  },
  "authentication": {
    "issuer": "https://${{AUTH_API_ADDRESS}}",
    "audience": "https://${{AUTH_API_ADDRESS}}",
    "secret": "${{AUTHENTICATION_SECRET}}"
  },
  "swagger": {
    "endpoint": "ms-limpo-api-${{CLIENTE}}",
    "title": "ms-limpo-api-${{CLIENTE}}",
    "enabled": "${{SWAGGER_ENABLED}}"
  },
  "masstransit": {
    "configured": "${{LIMPO_API_BROKER_CONFIGURED}}",
    "brokerTypeEnum": "${{BROKER_TYPE}}",
    "prefix": "limpo-${{CLIENTE}}",
    "server": "${{BROKER_ADDRESS}}",
    "port": "${{BROKER_PORT}}",
    "user": "${{BROKER_USER}}",
    "password": "${{BROKER_PASSWORD}}",
    "concurrentMessageLimit": 1,
    "environment": "",
    "virtualhost": ""
  },
  "services": {
    "provider-authentication": {
      "baseAddress": "https://${{AUTH_API_ADDRESS}}",
      "login": "${{AUTENTICACAO_LOGIN}}",
      "senha": "${{AUTENTICACAO_SENHA}}"
    },
    "auth": {
      "baseAddress": "https://${{AUTH_API_ADDRESS}}"
    }
  }
}