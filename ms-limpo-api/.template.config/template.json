{
  "$schema": "https://json.schemastore.org/template",
  "author": "MPS",
  "classifications": [
    "Web",
    "API",
    "Microservice"
  ],
  "identity": "Mps.Templates.Microservice",
  "name": "MPS Microservice",
  "shortName": "mps-microservice",
  "description": "Cria um microservice ASP.NET Core a partir do template Mps.Limpo.",
  "sourceName": "Limpo",
  "preferNameDirectory": false,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "serviceSlug": {
      "type": "parameter",
      "dataType": "text",
      "isRequired": true,
      "description": "Nome em kebab-case, por exemplo precatorio-calculo.",
      "replaces": "limpo",
      "fileRename": "limpo"
    },
    "serviceToken": {
      "type": "parameter",
      "dataType": "text",
      "isRequired": true,
      "description": "Nome em caixa alta com sublinhados, por exemplo PRECATORIO_CALCULO.",
      "replaces": "LIMPO",
      "fileRename": "LIMPO"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**",
        ".git/**",
        ".agents/**",
        ".aws/**",
        ".codex/**",
        ".vscode/**",
        "data/**",
        "**/TestResults/**",
        "**/results/**",
        "docker/.env",
        "TEMPLATE.md",
        "scripts/new-microservice.sh",
        "certificates/**",
        "**/*.pfx"
      ]
    }
  ],
