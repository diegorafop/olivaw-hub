# Mantido no template para acompanhar os projetos gerados.
# Use padrões genéricos, sem nomes de projetos ou caminhos de clientes.

# Compilação .NET em qualquer projeto ou cliente
[Bb]in/
[Oo]bj/
[Dd]ist/
artifacts/
BenchmarkDotNet.Artifacts/

# Resultados de testes e cobertura
[Tt]est[Rr]esults/
results/
coverage/
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml
coverage.opencover.xml
*.nupkg
*.snupkg

# Estado local das IDEs
.vs/
.idea/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Configuração local e certificados privados
.env
.env.*
!.env.example
!.env.*.example
appsettings.*.local.json
*.pfx
*.p12

# Logs e arquivos temporários
logs/
*.log
*.tmp
.DS_Store
Thumbs.db

# Cache dos scripts Python
__pycache__/
*.py[cod]
