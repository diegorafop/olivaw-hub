<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="gitea-xjp" value="https://git.mps.com.br/api/packages/XJP/nuget/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="gitea-xjp">
      <package pattern="Mps.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>