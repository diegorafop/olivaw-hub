{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "OlivawFrontend",
  "title": "Novo frontend Olivaw",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^ms-[a-z0-9]+(?:-[a-z0-9]+)*-ng$",
      "description": "Nome do projeto e da pasta irmã, como ms-cliente-ng."
    },
    "apiUrl": {
      "type": "string",
      "default": "http://localhost:5137",
      "description": "URL absoluta da API independente."
    },
    "siteDomain": { "type": "string", "description": "DNS público do frontend, sem protocolo." }
  }
}
