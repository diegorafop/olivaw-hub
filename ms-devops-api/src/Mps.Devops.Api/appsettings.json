{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "PostgreSql",
  "Database": {
    "ApplyMigrations": false
  },
  "Identity": {
    "Issuer": "ms-devops-api",
    "Audience": "ms-devops-api",
    "TokenMinutes": 30,
    "Bootstrap": {
      "Enabled": false
    }
  },
  "swagger": {
    "title": "Olivaw API",
    "version": "v1",
    "enabled": false
  },
  "masstransit": {
    "configured": false
  },
  "services": {
    "provider-authentication": {
      "serviceName": "provider-authentication",
      "cacheKey": "credential"
    },
    "loki": {
      "configured": false
    }
  },
  "authentication": {
    "oidc": {
      "standard-claims": {
        "sub": "sub"
      }
    }
  }
}
