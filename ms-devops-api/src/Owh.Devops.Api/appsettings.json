{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "PostgreSql",
  "Identity": {
    "Issuer": "ms-devops-api",
    "Audience": "ms-devops-api",
    "TokenMinutes": 30
  },
  "swagger": {
    "title": "ms-devops-api",
    "version": "v1",
    "enabled": false
  },
  "masstransit": {
    "configured": false,
    "consumer": false,
    "brokerTypeEnum": "RabbitMq",
    "server": "localhost",
    "port": 5672,
    "user": "",
    "password": "",
    "prefix": "ms-devops-api-dev",
    "environment": "dev",
    "virtualhost": "/"
  },
  "services": {
    "provider-authentication": {
      "serviceName": "provider-authentication",
      "cacheKey": "credential"
    },
    "loki": {
      "configured": false
    }
  },
  "authentication": {
    "oidc": {
      "standard-claims": {
        "sub": "sub"
      }
    }
  },
  "ConnectionStrings": {
    "DbContext": "",
    "RedisContext": ""
  },
  "Cache": {
    "Redis": {
      "Configured": false,
      "InstanceName": "ms-devops-api:"
    }
  }
}
