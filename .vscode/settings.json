{
  "editor.formatOnSave": true,
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.defaultFormatter": "ms-dotnettools.csharp",
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.semanticHighlighting.enabled": false
  },
  "yaml.format.enable": true,
  "yaml.format.singleQuote": false,
  "yaml.validate": true,
  "yaml.schemas": {
    "kubernetes": "/*.yaml"
  },
  "yapf.args": [
    "--style",
    "{based_on_style: pep8, indent_width: 2}"
  ],
  "[python]": {
    "editor.defaultFormatter": "eeyore.yapf",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modifications",
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.vs": true,
    "**/.angular": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/TestResults": true,
    "**/*.csproj.user": true,
    "**/results": true,
    "**/coverage": true,
    "**/artifacts": true,
    "**/BenchmarkDotNet.Artifacts": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.vs": true,
    "**/.angular": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/TestResults": true,
    "**/*.csproj.user": true,
    "**/results": true,
    "**/coverage": true,
    "**/artifacts": true,
    "**/BenchmarkDotNet.Artifacts": true,
    "**/.venv/**": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.vs": true,
    "**/.angular": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/TestResults": true,
    "**/*.csproj.user": true,
    "**/results": true,
    "**/coverage": true,
    "**/artifacts": true,
    "**/.venv/**": true,
    "**/__pycache__": true
  },
  "python.terminal.useEnvFile": true,
  "dotnet.defaultSolution": "Olivaw.sln"
}