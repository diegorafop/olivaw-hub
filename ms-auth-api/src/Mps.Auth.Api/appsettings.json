{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Debug"
      }
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "PostgreSql",
  "authentication": {
    "timeout": 1440,
    "oidc": {
      "issuer": "iss",
      "standard-claims": {
        "sub": "sub",
        "username": "preferred_username",
        "name": "name",
        "email": "email"
      },
      "custom-claims": {
        "matricula": "matricula",
        "emissor": "emissor",
        "ativo": "ativo",
        "reliability_info": "reliability_info",
        "level": "level"
      }
    }
  },
  "keycloak-provider": {
    "configured": true
  },
  "swagger": {
    "enabled": true,
    "title": "ms-auth-api",
    "version": "Version v03.03.06",
    "updatedAt": "0000-00-00 00:00:00 +00:00"
  },
  "masstransit": {
    "configured": true,
    "brokerTypeEnum": "RabbitMq",
    "server": "rabbit-desenvolvimento.holos.mps.com.br",
    "port": 5672,
    "user": "rabbit",
    "password": "mps2022*",
    "environment": "",
    "virtualhost": ""
  },
  "services": {
    "provider-authentication": {
      "serviceName": "provider-authentication",
      "authenticationType": "Bearer",
      "httpClientTimeout": 300,
      "defaultHeaders": "application/json",
      "cacheKey": "credential",
      "cacheSlidingExpiration": 1420,
      "routes": {
        "autenticar-usuario": "/autenticacao/autenticar"
      },
      "claims": {}
    },
    "loki": {
      "configured": true,
      "serviceName": "service-loki",
      "authenticationType": "Basic",
      "httpClientTimeout": 300,
      "defaultHeaders": "application/json",
      "routes": {},
      "claims": {
        "request-body-log-limit": 4096,
        "response-body-log-limit": 4096
      }
    },
    "usuario": {
      "configured": true,
      "serviceName": "usuario-service",
      "authenticationType": "Bearer",
      "httpClientTimeout": 300,
      "defaultHeaders": "application/json",
      "routes": {
        "documento-usuario-preferencia": "/documento-usuario-preferencia",
        "usuario": "/usuario",
        "usuario-cargo": "/usuario-cargo"
      },
      "claims": {}
    },
    "documento": {
      "configured": true,
      "serviceName": "documento-service",
      "authenticationType": "Bearer",
      "httpClientTimeout": 300,
      "defaultHeaders": "application/json",
      "routes": {
        "assunto-processo-admissao": "/assunto-processo-admissao"
      },
      "claims": {}
    },
    "notificacao": {
      "configured": true,
      "serviceName": "notificacao-service",
      "authenticationType": "Bearer",
      "httpClientTimeout": 300,
      "defaultHeaders": "application/json",
      "routes": {
        "destinatario": "/destinatario",
        "email-envio": "/email/endereco",
        "usuario-hub": "/hub/usuario"
      },
      "claims": {}
    },
    "holos-ng": {}
  },
  "constants": {
    "documento-usuario-preferencia": {
      "interessado": true
    },
    "perfil-acesso": {
      "basico": {
        "nome": "Perfil básico"
      }
    },
    "login": {
      "funcionario": "holos-funcionario",
      "gestor": "holos-gestor"
    },
    "roles-imutaveis": [
      "root",
      "Impersonate"
    ]
