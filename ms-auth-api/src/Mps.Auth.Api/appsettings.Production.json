{
  "ConnectionStrings": {
    "DbContext": "${{AUTH_API_CONNECTION_STRING}}"
  },
  "authentication": {
    "issuer": "https://${{AUTH_API_ADDRESS}}",
    "audience": "https://${{AUTH_API_ADDRESS}}",
    "secret": "${{AUTHENTICATION_SECRET}}"
  },
  "keycloak-provider": {
    "configured": ${{KEYCLOAK_PROVIDER_CONFIGURED}},
    "authority": "${{KEYCLOAK_PROVIDER_AUTHORITY}}",
    "clientId": "${{KEYCLOAK_PROVIDER_CLIENT_ID}}",
    "clientSecret": "${{KEYCLOAK_PROVIDER_CLIENT_SECRET}}",
    "responseType": "${{KEYCLOAK_PROVIDER_RESPONSE_TYPE}}",
    "scopes": [ ${{KEYCLOAK_PROVIDER_SCOPES}} ]
  },
  "swagger": {
    "endpoint": "ms-auth-api-${{CLIENTE}}",
    "title": "ms-auth-api-${{CLIENTE}}",
    "enabled": ${{SWAGGER_ENABLED}}
  },
  "masstransit": {
    "configured": ${{AUTH_API_BROKER_CONFIGURED}},
    "brokerTypeEnum": "${{BROKER_TYPE}}",
    "prefix": "auth-${{CLIENTE}}",
    "server": "${{BROKER_ADDRESS}}",
    "port": ${{BROKER_PORT}},
    "user": "${{BROKER_USER}}",
    "password": "${{BROKER_PASSWORD}}",
    "concurrentMessageLimit": 1,
    "environment": "",
    "virtualhost": ""
  },
  "services": {
    "provider-authentication": {
      "baseAddress": "https://${{AUTH_API_ADDRESS}}",
      "login": "${{AUTENTICACAO_LOGIN}}",
      "senha": "${{AUTENTICACAO_SENHA}}"
    },
    "loki": {
      "configured": ${{AUTH_API_LOKI_API_CONFIGURED}},
      "baseAddress": "${{LOKI_API_ADDRESS}}"
    },
    "documento": {
      "configured": ${{AUTH_API_DOCUMENTO_API_CONFIGURED}},
      "baseAddress": "https://${{DOCUMENTO_API_ADDRESS}}"
    },
    "notificacao": {
      "configured": ${{AUTH_API_NOTIFICACAO_API_CONFIGURED}},
      "baseAddress": "https://${{NOTIFICACAO_API_ADDRESS}}"
    },
    "usuario": {
      "configured": ${{AUTH_API_USUARIO_API_CONFIGURED}},
      "baseAddress": "https://${{USUARIO_API_ADDRESS}}"
    },
    "holos-ng": {
      "baseAddress": "https://${{HOLOS_NG_ADDRESS}}"
    }
  }
}