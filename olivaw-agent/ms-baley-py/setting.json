{
  "settingsVersion": 1,
  "agent": {
    "id": "baley",
    "module": "ms_baley"
  },
  "schedule": {
    "enabled": true,
    "intervalHours": 6
  },
  "execution": {
    "enabled": true,
    "timeoutSeconds": 900,
    "status": "configured"
  },
  "ai": {
    "enabled": true,
    "provider": "codex-cli",
    "model": null,
    "timeoutSeconds": 120
  },
  "skill": {
    "path": "../skills/safety-docker/SKILL.md"
  },
  "localState": {
    "directory": ".state",
    "maxBytes": 20971520,
    "retentionDays": 7
  },
  "update": {
    "timeoutSeconds": 15,
    "maxResponseBytes": 8388608,
    "maxCandidates": 100,
    "lookbackDays": 7,
    "discovery": {
      "provider": "bing-rss",
      "timeoutSeconds": 10,
      "maxResults": 10,
      "queries": [
        "\"security advisories\" Docker containerd runc sources",
        "\"NgRx\" \"security\" vulnerability advisories"
      ]
    }
  },
  "ssh": {
    "enabled": true,
    "host": "98.95.250.122",
    "port": 22,
    "user": "ec2-user",
    "privateKeyPath": "../../_secrets/olivaw-admin-2026.pem",
    "knownHostsPath": "~/.ssh/known_hosts",
    "strictHostKeyChecking": true,
    "connectTimeoutSeconds": 10,
    "connectionAttempts": 1,
    "validationStatus": "new-key-validated",
    "publicDns": "ec2-98-95-250-122.compute-1.amazonaws.com"
  },
  "audit": {
    "hostId": "fintalk-server",
    "logWindowHours": 6,
    "expectedPublicTcpPorts": [
      22,
      80,
      443
    ]
  },
  "reportApi": {
    "enabled": true,
    "baseUrl": "https://api.olivaw.com.br",
    "credentialsPath": "../../_secrets/admin.json",
    "credentialsSection": "baley"
  },
  "remediation": {
    "enabled": true,
    "pollSeconds": 30
  }
}
